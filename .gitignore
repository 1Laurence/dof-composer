# ---------- Python 字节码 ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- 构建产物 ----------
build/
dist/
*.egg-info/
.eggs/
wheels/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- 测试与类型检查缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ---------- 模型权重 ----------
# 大文件绝不入库，请按 README 下载到对应位置
models/
checkpoints/
*.pth
*.pt
*.safetensors
*.onnx
*.ckpt
*.bin

# ---------- 第三方上游仓库 ----------
# Depth-Anything-V2 需使用者自行 clone（约 1.4GB，且含其自身许可证）
# 本项目只依赖它，不重新分发它
Depth-Anything-V2/
third_party/
BiRefNet/

# ---------- 输入输出 ----------
# 运行产物一律不入库；样例图另见 docs/samples/（那部分是文档资产，要提交）
/data/
/samples/
/out/
/output/
/runs/
*.npy
*.npz

# ---------- 实验结果与临时产物 ----------
# 开发期用于对比调参的中间文件
_cmp_*.png
_dof_cmp_*.png
_probe_*.py
_test_*.py

# 程序输出（用户可用 -o 指定任意目录）
# 只挡默认的 out/ 不够：-o 自定义目录时产物会混进仓库。
# 这几个名字是 CLI 的固定前缀，见 cli.py 的 OUTPUT_PREFIX_*。
alpha_*.png
depth_*.png
depth_colormap_*.png
dof_*.png

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
*.swp
*~
.ipynb_checkpoints/
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本地环境变量 ----------
.env
.env.*
!.env.example